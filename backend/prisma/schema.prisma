generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  volunteer
  org_admin
}

enum ShiftStatus {
  draft
  open
  closed
}

enum ReservationStatus {
  pending
  approved
  denied
  waitlisted
}

enum ShiftCategory {
  food
  education
  environment
  health
  animals
  arts
  community
  sports
  other
}

model User {
  id                String        @id @default(uuid())
  name              String
  email             String        @unique
  password_hash     String
  role              Role
  skills            String[]
  availability_json Json?
  created_at        DateTime      @default(now())

  organization  Organization?
  reservations  Reservation[]
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  cause_area    String
  description   String?
  logo_url      String?
  admin_user_id String   @unique

  admin_user User    @relation(fields: [admin_user_id], references: [id])
  shifts     Shift[]
}

model Shift {
  id            String         @id @default(uuid())
  org_id        String
  title         String
  description   String?
  date          DateTime
  start_time    String?        // "HH:MM" 24-hour
  end_time      String?        // "HH:MM" 24-hour
  duration      Int?           // minutes
  location      String
  capacity      Int            // total across all positions
  category      ShiftCategory  @default(other)
  requirements  String?
  what_to_bring String?
  is_recurring  Boolean        @default(false)
  contact_name  String?
  contact_email String?
  status        ShiftStatus    @default(draft)
  ai_generated  Boolean        @default(false)
  created_at    DateTime       @default(now())

  org          Organization    @relation(fields: [org_id], references: [id])
  positions    ShiftPosition[]
  reservations Reservation[]
}

model ShiftPosition {
  id          String   @id @default(uuid())
  shift_id    String
  name        String
  description String?
  capacity    Int
  created_at  DateTime @default(now())

  shift        Shift         @relation(fields: [shift_id], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

model Reservation {
  id                String            @id @default(uuid())
  shift_id          String
  position_id       String?
  volunteer_id      String
  status            ReservationStatus @default(pending)
  waitlist_position Int?
  created_at        DateTime          @default(now())

  shift     Shift          @relation(fields: [shift_id], references: [id])
  position  ShiftPosition? @relation(fields: [position_id], references: [id])
  volunteer User           @relation(fields: [volunteer_id], references: [id])
}
