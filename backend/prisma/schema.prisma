generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  volunteer
  org_admin
}

enum ShiftStatus {
  draft
  open
  closed
}

enum ReservationStatus {
  pending
  approved
  denied
  waitlisted
}

model User {
  id                String        @id @default(uuid())
  name              String
  email             String        @unique
  password_hash     String
  role              Role
  skills            String[]
  availability_json Json?
  created_at        DateTime      @default(now())

  organization  Organization?
  reservations  Reservation[]
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  cause_area    String
  description   String?
  logo_url      String?
  admin_user_id String   @unique

  admin_user User    @relation(fields: [admin_user_id], references: [id])
  shifts     Shift[]
}

model Shift {
  id           String      @id @default(uuid())
  org_id       String
  title        String
  description  String?
  date         DateTime
  location     String
  capacity     Int
  status       ShiftStatus @default(draft)
  ai_generated Boolean     @default(false)
  created_at   DateTime    @default(now())

  org          Organization  @relation(fields: [org_id], references: [id])
  reservations Reservation[]
}

model Reservation {
  id               String            @id @default(uuid())
  shift_id         String
  volunteer_id     String
  status           ReservationStatus @default(pending)
  waitlist_position Int?
  created_at       DateTime          @default(now())

  shift     Shift @relation(fields: [shift_id], references: [id])
  volunteer User  @relation(fields: [volunteer_id], references: [id])
}
